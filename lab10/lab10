% Task 2: Login System
% ----------------------------------------

% Dataset: Username and Password
user_account(ali, pass123).
user_account(sara, hello456).
user_account(ahmed, abc123).

% Start login with 3 attempts
login :-
    login_attempts(3).

% Check username and password
login_attempts(Attempts) :-
    write('Enter username: '),
    read(Username),

    write('Enter password: '),
    read(Password),

    ( user_account(Username, Password) ->
        write('Login Successful'), nl

    ;
        write('Login Unsuccessful'), nl,

        ( Attempts > 1 ->
            Remaining is Attempts - 1,
            login_attempts(Remaining)

        ;
            write('Sorry, you exceeded the maximum number of attempts, try again later.'),
            nl
        )
    ).


